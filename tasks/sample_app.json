{
  "appName": "示例激励 App",
  "package": "com.example.reward",
  "activity": "com.example.reward.MainActivity",
  "home": { "tap": [0.5, 0.95] },
  "loop": {
    "rounds": 20,
    "openApp": true,
    "swipe": { "from": [0.5, 0.82], "to": [0.5, 0.18], "ms": 400, "times": 3 },
    "ad": {
      "region": [0.06, 0.55, 0.88, 0.40],
      "mode": "region",
      "search": [0.0, 0.0, 1.0, 1.0],
      "keywords": ["广告", "查看详情", "立即下载", "领取"],
      "maxClicks": 2
    },
    "reward": {
      "button": [0.5, 0.86],
      "verifyRegion": [0.35, 0.10, 0.30, 0.18],
      "timeoutMs": 8000,
      "successKeywords": ["领取成功", "已领取", "+", "金币", "成功"]
    },
    "backHome": true,
    "intervalMs": 1000
  }
}
